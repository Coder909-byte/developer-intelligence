{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Developer Intelligence",
  "version": "0.1.0",
  "identifier": "dev.udi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Developer Intelligence",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:4317 http://localhost:4317"
    }
  },
  "bundle": {
    "active": false
  }
}
