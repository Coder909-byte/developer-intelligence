{
  "name": "developer-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n daemon,desktop \"pnpm --filter @udi/core-daemon dev\" \"pnpm --filter @udi/desktop dev\"",
    "dev:daemon": "pnpm build:packages && pnpm --filter @udi/core-daemon dev",
    "dev:core": "pnpm dev:daemon",
    "dev:desktop": "pnpm build:packages && pnpm --filter @udi/desktop dev",
    "dev:extension": "pnpm build:packages && pnpm --filter @udi/vscode-extension dev",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm build:packages && vitest run",
    "test:integration": "pnpm build:packages && vitest run apps/core-daemon",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "~1.95.0",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "vitest": "5.1.0",
    "tsx": "^4.20.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2"
  }
}
